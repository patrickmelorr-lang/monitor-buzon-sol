#!/bin/sh
# Guardián anti-secretos del repositorio público "Monitor Buzón SOL".
#
# Se ejecuta solo, antes de cada commit, y lo ABORTA si detecta algo que no debe
# hacerse público. Es la red de seguridad por si el .gitignore se edita por error.
#
# Instalar (una vez por clon):   bash scripts/instalar-hook.sh
# Saltarlo a conciencia:         SALTAR_GUARDIAN=1 git commit ...

[ "$SALTAR_GUARDIAN" = "1" ] && exit 0

raiz=$(git rev-parse --show-toplevel)
archivos=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$archivos" ] && exit 0
fallos=0

aviso() {
  [ "$fallos" -eq 0 ] && printf '\n*** COMMIT BLOQUEADO: contenido sensible detectado ***\n\n'
  printf '  [%s] %s\n' "$1" "$2"
  fallos=$((fallos + 1))
}

# ---- 1) Archivos que jamás se publican, por nombre ----
for f in $archivos; do
  case "$f" in
    *.xlsx|*.xls|*.cifradas|*.env|LINKS.txt|GERENCIA-RESUMEN.md|\
    PROPUESTAS-NOTIFICACIONES-SUNAT.md|PORTABLE-CONTADORA/*|robot/data/*|robot/logs/*)
      aviso "archivo prohibido" "$f" ;;
  esac
done

# ---- 2) Secretos dentro del contenido ----
for f in $archivos; do
  git show ":$f" 2>/dev/null > /dev/null || continue
  contenido=$(git show ":$f" 2>/dev/null)

  # Token de bot de Telegram:  123456789:AAE...
  echo "$contenido" | grep -qE '[0-9]{8,12}:[A-Za-z0-9_-]{30,}' \
    && aviso "token de Telegram" "$f"

  # chat_id de grupo de Telegram
  echo "$contenido" | grep -qE '\-100[0-9]{10}' \
    && ! echo "$f" | grep -q 'credenciales.py' \
    && aviso "chat_id de Telegram" "$f"

  # RUC peruano real (11 dígitos). Los marcadores 20XXXXXXXXX no coinciden.
  echo "$contenido" | grep -qE '\b(10|15|16|17|20)[0-9]{9}\b' \
    && aviso "RUC real" "$f"

  # Razones sociales y otros términos privados.
  # OJO: los nombres NO van escritos aquí — este archivo es público y publicarlos
  # sería la fuga que queremos evitar. Viven en .patrones-privados (ignorado por git),
  # una expresión regular por línea. Si el archivo no existe, este chequeo se omite.
  if [ -f "$raiz/.patrones-privados" ]; then
    while IFS= read -r patron; do
      [ -z "$patron" ] && continue
      case "$patron" in \#*) continue ;; esac
      echo "$contenido" | grep -qiE "$patron" && aviso "término privado" "$f"
    done < "$raiz/.patrones-privados"
  fi
done

if [ "$fallos" -gt 0 ]; then
  printf '\n  %s problema(s). Este repositorio es PUBLICO.\n' "$fallos"
  printf '  Quita el archivo del commit (git restore --staged <archivo>) o censura el dato.\n'
  printf '  Si estas seguro de que es un falso positivo:  SALTAR_GUARDIAN=1 git commit ...\n\n'
  exit 1
fi
exit 0
